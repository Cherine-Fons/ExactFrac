include .gitignore
include LICENSE
include README.md
include CITATION.cff
include pyproject.toml
include MANIFEST.in
include GOVERNING_SHA256SUMS.txt
include release_audit.py
include docs/RELEASE.md
recursive-include exactfrac *.py
recursive-include exactfrac_verify *.py
recursive-include tests *.py *.json
recursive-include docs *.md
recursive-include instances *
recursive-include results *
recursive-include experiments *
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
global-exclude BUILD_NOTES*
global-exclude LEARNING_NOTES*
prune .git
prune .venv
prune artifacts
prune build
prune dist
